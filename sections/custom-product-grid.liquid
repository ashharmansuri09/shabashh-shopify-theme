<script src="{{ 'custom-event.js' | asset_url }}" defer="defer"></script>
{% liquid
  assign title = section.settings.title
  assign products = section.settings.products
%}

{% style %}
  .custom-product-grid__products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .custom-product-grid__product-image {
    height: 350px;
    position: relative;
  }
  button.custom-product-grid__product-modal-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 25px;
    height: 25px;
    border: none;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
  }
  button.custom-product-grid__product-modal-button svg {
    width: 15px;
    height: 15px;
  }
  .custom-product-grid__product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h3.custom-product-grid__product-title {
    margin: 0;
    text-transform: uppercase;
    font-weight: 600;
  }
  h3.custom-product-grid__product-title a {
    text-decoration: none;
    color: black;
    padding: 0 10px;
  }

  /* modal styles */
  .custom-product-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 999;
  }
  .custom-product-modal.active {
    display: flex;
  }
  .custom-product-modal__content {
    background: white;
    padding: 30px 20px 20px 20px;
    max-width: 375px;
    width: 100%;
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
  }
  .custom-product-modal__product-image {
    display: flex;
    gap: 15px;
  }
  .custom-product-modal__product-image img {
    height: 175px;
    width: 140px;
  }
  .custom-product-modal__product-wrapper {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .custom-product-modal__product-wrapper h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }
  .custom-product-modal_description p {
    font-size: 14px;
    line-height: 1.4;
  }
  .custom-product-modal__close {
    position: absolute;
    top: 5px;
    right: 5px;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
  }
  .custom-product-modal__variants-option h3 {
    margin: 0;
    font-size:14px;
    font-weight:600;
    margin-top:5px;
}
.custom-product-modal__variants-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.custom-product-modal__variants-option-values {
    margin-top: 5px;
}
.custom-product-modal__variants-option-values label {
    display: inline-block;
    margin-right: 10px;
    margin-bottom: 5px;
    cursor: pointer;
}
.custom-product-modal__variants-option-values input[type="radio"] {
    margin-right: 5px;
}
.custom-product-modal__variants-option-values select {
    width: 100%;
    padding: 5px;
    border: 1px solid #ccc;
    border-radius: 4px;
}
{% endstyle %}

<section class="custom-product-grid">
  <div class="page-width">
    <div class="custom-product-grid__container">
      <div class="custom-product-grid__header">
        <h2 class="custom-product-grid__title">{{ title }}</h2>
      </div>

      <div class="custom-product-grid__content">
        <div class="custom-product-grid__products">
          {% for product in products %}
            <div class="custom-product-grid__product" data-product-id="{{ product.id }}">
              <div class="custom-product-grid__product-image">
                <img
                  src="{{ product.featured_image | image_url: width: 250 }}"
                  alt="{{ product.title }}"
                  width="250"
                  height="250"
                >
                <button class="custom-product-grid__product-modal-button">
                  {% render 'icon-plus' %}
                </button>
              </div>
              <h3 class="custom-product-grid__product-title">
                <a href="{{ product.url }}" title="{{ product.title }}">{{ product.title }}</a>
              </h3>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <!-- single reusable modal -->
  <product-modal>
    <div class="custom-product-modal" id="custom-product-modal" hidden>
      <div class="custom-product-modal__overlay"></div>
      <div class="custom-product-modal__content">
        <button class="custom-product-modal__close">&times;</button>
        <div id="custom-product-modal-body"></div>
      </div>
    </div>
  </product-modal>

  <!-- hidden product templates (Liquid-rendered) -->
  {% for product in products %}
    <template id="product-template-{{ product.id }}">
      <div class="custom-product-modal__product">
        <div class="custom-product-modal__product-image">
          <img
            src="{{ product.featured_image | image_url: width: 500 }}"
            alt="{{ product.title }}"
            width="100"
            height="100"
          >
          <div class="custom-product-modal__product-wrapper">
            <h2>{{ product.title }}</h2>
            <div class="custom-product-modal_description">{{ product.description }}</div>
            <script type="application/json" class="product-data-modal">
                {{ product | json }}
              </script>
          </div>
        </div>

        {% unless product.has_only_default_variant %}
          <variant-picker-modal data-section-id="{{ section.id }}" class="custom-product-modal__variants">
            <div class="custom-product-modal__variants-list">
              {% for option in product.options_with_values %}
                <div class="custom-product-modal__variants-option">
                  <h3>{{ option.name }}</h3>
                  {% if option.name == 'Color' %}
                    <div class="custom-product-modal__variants-option-values">
                      {% for value in option.values %}
                        <label for="{{ option.name }}-{{ value.name }}">
                          <input value={{ value.variant.id }}
                             type="radio" name="{{ option.name }}" id="{{ option.name }}-{{ value.name }}"
                          {% if option.selected_value == value %}
                            checked
                          {% endif %}>
                          {{- value }}
                        </label>
                      {% endfor %}
                    </div>
                  {% endif %}
                  {% if option.name == 'Size' %}
                    <div class="custom-product-modal__variants-option-values">
                    <select name="{{ option.name }}" id="{{ option.name }}">
                      {% for value in option.values %}
                        <option value="{{ value.variant.id }}"
                            {% if option.selected_value == value %}
                                selected
                              {% endif %}>{{ value.name }}</option>
                      {% endfor %}
                    </select>
                    </div>
                  {% endif %}
                  {% if option.name == 'Fabric' %}
                    <div class="custom-product-modal__variants-option-values">
                      {% for value in option.values %}
                        <input value={{ value.variant.id }}
                             type="radio" name="{{ option.name }}" id="{{ option.name }}-{{ value.name }}"
                            {% if option.selected_value == value %}
                                checked
                            {% endif %}>
                        <label for="{{ option.name }}-{{ value.name }}">{{ value }}</label>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </variant-picker-modal>
        {% endunless %}

       <div class="custom-product-modal__add-to-cart">
        {% render 'atc-button', product: product %}
       </div>
      </div>
    </template>
  {% endfor %}
</section>



{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}
